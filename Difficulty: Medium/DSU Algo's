
DSU by rank

#include <bits/stdc++.h>
using namespace std;

vector<int> parent;
vector<int> rank;


int find(int x){
    if(parent[x]==x){
        return x;
    }
    find(parent[x]);
}

void Union(int a, int b){
    int pa = find(a);
    int pb = find(b);
    
    if(pa == pb){
        return;
    }
    if(rank[pa]<rank[pb]){
        par[pa]=pb;
    }
    else if(rank[pa]>rank[pb]){
        par[pb]=pa;
    }
    else{
        parent[pa]=pb;
        rank[pa]++
    }
}

int main() {
    // your code goes here
    int n;
    cin>>n;
    parent=vector<int>(n);
    rank=vector<int>(n,0);
    
    for(int i=0; i<n; i++){
        parent[i]=i;
    }
return 0;

}
